{
  "name": "spicemobile",
  "version": "0.2.3",
  "description": "Interface mobile pour le lecteur web Spotify : layout une colonne, bibliothèque en tiroir, barre de navigation en bas, gros boutons, swipe pour changer de titre.",
  "license": "MIT",
  "author": "Peze Thomas",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "userscript": {
    "name": "SpiceMobile",
    "githubUser": "Thomas-Peze28",
    "repo": "spicemobile",
    "match": [
      "https://open.spotify.com/*"
    ],
    "runAt": "document-start",
    "grant": [
      "none"
    ]
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vitest": "^5.1.1"
  }
}
